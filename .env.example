# 이 파일을 복사해서 .env 를 만드세요.
#   cp .env.example .env
# .env 는 git에 올라가지 않습니다. 실제 키를 여기(.env.example)에 적지 마세요.

# API 서버 주소 — 비워 두면 같은 오리진으로 /api/v1 요청이 나가고
# Vercel 프록시(vercel.json)가 백엔드로 넘깁니다. 보통 그대로 둡니다.
# 로컬에 백엔드를 직접 띄워 붙일 때만 http://localhost:8080 처럼 채웁니다.
VITE_API_URL=

# 카카오맵 JavaScript 키 (지도 작업 시작할 때 채우세요)
VITE_KAKAO_MAP_KEY=

# 백엔드 없이 화면만 볼 때 true. 기본값은 실서버 연동입니다.
VITE_USE_MOCK=false
