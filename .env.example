# 이 파일을 복사해서 .env 를 만드세요.
#   cp .env.example .env
# .env 는 git에 올라가지 않습니다. 실제 키를 여기(.env.example)에 적지 마세요.

# API 서버 주소
VITE_API_BASE_URL=http://localhost:8080

# 카카오맵 JavaScript 키 (지도 작업 시작할 때 채우세요)
VITE_KAKAO_MAP_KEY=

# 백엔드 연동 전까지 목 응답 사용. 연동되면 false 로 바꾸세요.
# 목 로그인 계정: test@mulmeong.kr / mulmeong1234
# 목 중복 닉네임: 온탕러버, 물멍, 사우나킹
VITE_USE_MOCK=true
